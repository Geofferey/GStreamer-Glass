<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows a system splash screen on cold start whether the app asks for one or
         not, and leaving windowSplashScreenAnimatedIcon unset doesn't mean "no icon" - it means
         "auto-derive one from android:icon", which the system then shows in its own icon slot.
         That slot's backdrop is a hardcoded <shape android:shape="oval"> (confirmed by
         decompiling the platform's own splash resources), so it's the source of the round icon
         flash, not our own overlay. Making the icon transparent and matching its background
         color to the overall splash background makes this brief, otherwise-unavoidable system
         phase render as a plain color with nothing visible in it, before MainActivity's own
         square icon overlay takes over. -->
    <!-- Not .Fullscreen here either - see values/themes.xml for why that legacy flag breaks
         showSystemBars()'s ability to actually reclaim layout space for the status bar. -->
    <style name="AppTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
</resources>
